{
  "name": "emailagent",
  "version": "0.1.0",
  "private": true,
  "description": "QQ and 163 desktop email assistant",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "electron-vite preview",
    "backend:build": "tsc --project tsconfig.backend.json",
    "backend:start": "node --env-file=.env out/backend/backend/index.js",
    "backend:migrate": "npm run backend:build && node --env-file=.env out/backend/backend/migrate.js",
    "services:up": "docker compose up -d --build --wait",
    "services:down": "docker compose down",
    "test:backend": "node scripts/run-backend-tests.mjs",
    "package:mac": "npm run backend:build && npm run build && node scripts/prepare-runtime.mjs && electron-builder --mac dir --publish never --config.electronDist=node_modules/electron/dist"
  },
  "dependencies": {
    "@ant-design/plots": "2.6.8",
    "antd": "6.6.5",
    "dompurify": "3.4.15",
    "imapflow": "2.1.2",
    "mailparser": "3.9.32",
    "mysql2": "3.24.5",
    "nodemailer": "10.0.13",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.19.1",
    "@types/nodemailer": "^7.0.10",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "28.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.0.18"
  }
}
